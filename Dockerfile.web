FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# uv installs exactly what uv.lock pins, in seconds rather than minutes.
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PYTHON_DOWNLOADS=never

# spotdl gets its own virtualenv: every release pins fastapi<0.104,
# uvicorn<0.24 and rich<14, which would hold the whole web stack back. The app
# runs it as a subprocess, located through SPOTDL_BIN.
COPY requirements-spotdl.txt /tmp/requirements-spotdl.txt
RUN uv venv /opt/spotdl && \
    uv pip install --no-cache --python /opt/spotdl/bin/python -r /tmp/requirements-spotdl.txt
ENV SPOTDL_BIN=/opt/spotdl/bin/spotdl

WORKDIR /app

# Dependencies straight from the lockfile, in their own layer so code edits
# don't reinstall them. (deno arrives as a pip wheel.)
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-install-project --no-dev --extra web --no-cache
ENV PATH="/app/.venv/bin:$PATH"

COPY main.py web_app.py /app/
COPY src/ /app/src/
COPY templates/ /app/templates/
COPY static/ /app/static/
RUN mkdir -p /music

EXPOSE 8080
ENTRYPOINT ["uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8080"]
