FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg curl unzip && \
    rm -rf /var/lib/apt/lists/*

# Install Deno (required by yt-dlp for YouTube JS extraction)
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh

RUN pip install --no-cache-dir \
    spotdl spotipy python-dotenv scdl yt-dlp psutil rich \
    fastapi uvicorn jinja2 python-multipart aiofiles

WORKDIR /app
COPY main.py /app/main.py
COPY web_app.py /app/web_app.py
COPY src/ /app/src/
COPY templates/ /app/templates/
COPY static/ /app/static/
RUN mkdir -p /music

EXPOSE 8080
ENTRYPOINT ["uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8080"]
