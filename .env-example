# Everything here is optional — Multi-MP3 runs without a .env at all.

# Spotify developer app. spotdl reads Spotify without one, so leave these
# empty unless you have a reason to use your own (the account that owns it
# needs Spotify Premium).
CLIENTID=
CLIENTSECRET=

# Ping your phone when a run finishes: an ntfy topic (https://ntfy.sh/your-topic)
# or a Discord webhook URL.
NOTIFY_URL=

# Require a login for the web UI (it listens on your whole network).
WEB_USERNAME=
WEB_PASSWORD=

# Speed tuning (the Balanced preset; Fast is derived from it). See README.
# SOUNDCLOUD_WORKERS=3
# SOUNDCLOUD_RATE=20
# SOUNDCLOUD_MAX_RATE=40
# YOUTUBE_WORKERS=3
# YOUTUBE_RATE=30
# SPOTIFY_WORKERS=2
# SPOTIFY_THREADS=6
# SOUNDCLOUD_AUTH_TOKEN=
